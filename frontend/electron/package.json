{
  "name": "electron",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:publish": "electron-builder --win --publish always"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.floatnote.app",
    "productName": "FloatNote",
    "files": [
      "main.js",
      "config-store.js",
      "backend-process.js",
      "first-run/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "../react-app/dist", "to": "react-app/dist" },
      { "from": "../../backend/dist/FloatNoteBackend", "to": "backend" }
    ],
    "directories": {
      "output": "../../release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "ParvTiwari",
      "repo": "FloatNote",
      "releaseType": "draft"
    }
  }
}
