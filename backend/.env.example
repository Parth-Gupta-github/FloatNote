# Example backend environment variables for FloatNote
# Copy this file to backend/.env and edit values (DO NOT commit secrets).

# Server bind settings
HOST=0.0.0.0
PORT=8000

# Hugging Face (required for summarizer/chat features)
HUGGINGFACEHUB_API_TOKEN=
HUGGINGFACE_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_SUMMARIZER_REPO_ID=facebook/bart-large-cnn

# OCR and capture tuning
ENABLE_OCR=true
OCR_INTERVAL_SECONDS=3.0
OCR_CHANGE_THRESHOLD=0.02
OCR_MONITOR_INDEX=1

# Optional: tweak these for your environment
# SAMPLE_RATE=16000
# CHUNK_SECONDS=3